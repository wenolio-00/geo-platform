{
  "hooks": {
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh -c '\"${CLAUDE_PROJECT_DIR:-$PWD}\"/.claude/hooks/worktree-create.sh'"
          }
        ]
      }
    ],
    "WorktreeRemove": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh -c '\"${CLAUDE_PROJECT_DIR:-$PWD}\"/.claude/hooks/worktree-remove.sh'"
          }
        ]
      }
    ]
  }
}
